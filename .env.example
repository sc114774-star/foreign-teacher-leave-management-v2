# Public browser configuration. Copy to .env.local for local development.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional analytics configuration used by the Vite HTML template.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Server-side / Supabase Edge Function secrets must be configured in Supabase,
# never in VITE_ variables or committed files:
# SUPABASE_SERVICE_ROLE_KEY=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_CINGSHAN_RECIPIENT_ID=
# LINE_DONGYUAN_RECIPIENT_ID=
